# Environment Configuration Template
# Copy this file to .env and configure your environment

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (Generate a random 32+ character string)
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-secret"

# Node Environment (development | production | test)
NODE_ENV="development"

# Site Public URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

